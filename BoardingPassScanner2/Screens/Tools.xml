<body>
    <list navigationTitle="$TEXT_TOOLS">
        
        <section header="Data Library">
            <text badge="$dataFilesVersion">Data Library Version</text>
            <navigationlink destination="viewDatabaseAirlines">
                <label systemImage="airplane">Airlines</label>
            </navigationlink>
            <navigationlink destination="viewDatabaseAirports">
                <label systemImage="airplane.departure">Airports</label>
            </navigationlink>
            <button action="checkForDataUpdate">checkForDataUpdate add dialog</button>
            
        </section>
        
    </list>
    
    
    <extendedlist id="viewDatabaseAirlines" navigationTitle="Airlines ($dataModelAirlines.count)" xnavTrailing="id:buttonsTrailing" autocapitalization="none" disableAutocorrection="true" dataModel="dataModelAirlines" searchable="mode:starts;allMustMatch:false;keys:[name,code];caseSensitive:false" xcontentUnavailable="contentNoData">
        <text badge="$dataModel.code">$dataModel.name</text>
    </extendedlist>
    
    <extendedlist id="viewDatabaseAirports" navigationTitle="Airports ($dataModelAirports.count)" xnavTrailing="id:buttonsTrailing" autocapitalization="none" disableAutocorrection="true" dataModel="dataModelAirports" searchable="mode:starts;allMustMatch:false;keys:[name,code];caseSensitive:false" xcontentUnavailable="contentNoData">
        <vstack>
        <text badge="$dataModel.code">Code</text>
        <text badge="$dataModel.name">Name</text>
        <text badge="$dataModel.city">City</text>
        <text badge="$dataModel.country">Country</text>
        </vstack>
    </extendedlist>
    
</body>
