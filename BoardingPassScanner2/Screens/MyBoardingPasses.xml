<body>
    <vstack>
        <extendedlist navigationTitle="js: $dataModelMyCodes.count == 0 ? 'My Codes' : 'My Codes ($dataModelMyCodes.count)'" navTrailing="id:buttonsTrailing" autocapitalization="none" disableAutocorrection="true" dataModel="dataModelMyCodes" searchable="mode:contains;allMustMatch:false;keys:[name,type];caseSensitive:false" contentUnavailable="contentNoData" reversed="$isReversed" onFirstAppear="checkForUpdate">

            <navigationlink destination="resource:MyCode-View" action="selectItem:selectedCode">
                <hstack>
                    <barcodeicon name="$dataModel.name" size="40"/>
                    <vstack alignment="leading">
                    <text foregroundColor="primary">$dataModel.name</text>
                    <text font="caption" monospaced="">$dataModel.text</text>
                    <text foregroundColor="secondary" font="footnote">$dataModel.type</text>
                    <text foregroundColor="secondary" font="footnote">flightDate: $dataModel.flightDate</text>
                    <text>summary: $dataModel.summary</text>
                    </vstack>
                </hstack>
            </navigationlink>
            

        </extendedlist>
<!--        <admob ifnot="$FEATURE_ADS_REMOVED"></admob>-->
        <text>Reklama</text>
    </vstack>
    
    <!-- This view will be displayed if list is empty -->
    <contentunavailableview id="contentNoData" title="No Barcodes" description="Your scanned barcodes will appear here."/>
    
    
    <!-- Option menu -->
    <hstack id="buttonsTrailing">
    <menu systemImage="ellipsis.circle" labelStyle="iconOnly">
        <button if="$DEBUG_MODE" action="presentSheet:item:sheetItem;id:sheetScanSimulatorView">DEBUG: ScanSimulator</button>
        <button if="$DEBUG_MODE" action="importData:dataModelName:dataModelMyCodes;type:csv;src:resource:TestImport.csv">DEBUG: Import from resource</button>
        
        <button action="importCodes">
            <label systemImage="tray.and.arrow.down">Import codes</label>
        </button>
        
        <button disabled="js:'$dataModelMyCodes.count' == '0'" action="exportCodes">
            <label systemImage="tray.and.arrow.up">Export codes</label>
        </button>
        
        <button disabled="js:'$dataModelMyCodes.count' == '0'" role="destructive" action="presentAlert:item:alertItem;id:myAlertClearHistory">
            <label systemImage="trash">Delete all barcodes</label>
        </button>
        
        <divider/>
        
        <toggle key="isReversed" value="false">Reverse Order</toggle>
    </menu>
    <menu systemImage="plus" labelStyle="iconOnly">
        <button action="presentSheet:item:sheetItem;id:barcodeScannerView">
            <label systemImage="qrcode.viewfinder">Scan New Barcode</label>
        </button>
        <button action="setBool:isShowingImagePicker=true">
            <label systemImage="photo.on.rectangle">Import From Photo</label>
        </button>
    </menu>
    </hstack>
    
</body>
