<body>
    <tabview key="selectedTab" value="Home" alert="item:alertItem" alert2="KEY_SHOW_BARCODE_INPUT_ALERT" sheet="item:sheetItem" photospicker2="isShowingImagePicker" onFirstAppear="setString:selectedTab=$settingsStartupTab">
        <navigationstack tabItem="label:$TEXT_HOME;systemImage:house" tag="Home">
           <homeview/>
        </navigationstack>
       
        <navigationstack tabItem="label:$TEXT_MYPASSES;systemImage:qrcode" tag="MyCodes">
           <myBoardingPassesList/>
        </navigationstack>
        
        <navigationstack tabItem="label:$TEXT_TOOLS;systemImage:wrench.and.screwdriver" tag="Tools">
           <toolsview/>
        </navigationstack>
               
        <navigationstack tabItem="label:$TEXT_SETTINGS;systemImage:gear" tag="Settings">
            <remoteview src="resource:Settings"/>
        </navigationstack>
    </tabview>
    
    <!--    For displaying camera scanner sheet-->
    <remoteview id="scannerView" src="resource:ScannerView"/>
    
    <remoteview id="sheetScanSimulatorView" src="file:live/SXML/DebugOnly/ScanSimulator.xml"/>
    
    <remoteview id="sheetPremiumFeatures" src="file:live/SXML/Sheets/PremiumFeatures.xml"/>
    
    
    <event onValueUpdated="xxtorchActivated" action="torch:$torchActivated;level:$torchLevel"/>
    <event onValueUpdated="xxtorchLevel" action="torch:$torchActivated;level:$torchLevel"/>
    
    
<!--    <event onBarcodeDetected="" action="js:generateAction('$barcodeRectDelay', $barcodeRectSound)"/>-->
    <event onBarcodeDetected="" action="playSystemSound:4095\\addNewBoardingPass:type:$barcodeObject.type;text:$barcodeObject.text"/>
    
    <dialogs>
        <alert id="myAlertCode" alertTitle="Detected barcode" alertMessage="$barcodeObject.text">
        </alert>
        
        <alert id="myAlertInvalidBoardingPassCode" alertTitle="Invalid Boarding Pass" alertMessage="The detected barcode is not a valid boarding pass format.">
        </alert>
      

        
        <alert id="myAlertCannotDetectBarcode" alertTitle="No Boarding Pass Found" alertMessage="We couldn’t detect a boarding pass in the selected image. Please try another screenshot or photo."/>
        
        <alert
            id="myAlertBoardingPassAlreadyExists"
            alertTitle="Boarding Pass Already Added"
            alertMessage="This boarding pass has already been added to your passes. Please try a different one."
        />
   
    </dialogs>
    
    
   <!-- Default settings -->
       <setDefault key="settingsStartupTab" type="string" value="Home"/>
       <setDefault key="barcodeRectColor" type="color" value="yellow"/>
       <setDefault key="barcodeRectLineWidth" type="int" value="8"/>
       <setDefault key="barcodeRectDelay" type="int" value="4"/>
       <setDefault key="barcodeRectSound" type="bool" value="true"/>
       
       <setDefault key="settingsViewfinderColor" type="color" value="green"/>
       <setDefault key="settingsViewfinderWidth" type="int" value="20"/>
   
   
</body>
