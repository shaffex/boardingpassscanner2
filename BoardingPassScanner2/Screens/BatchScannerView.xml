<body>
    <navigationview onAppear="setBool:isShowingViewFinder=true">
    <zstack id="barcodeScannerViewBatch" navLeading="id:buttonCancelBatch" navTrailing="id:buttonTorchToggleBatch">
    <barcodescannerlocal key="barcodeObject" batch="true" rectColor="$barcodeRectColor" rectWidth="$barcodeRectLineWidth"/>
    <vstack background="clear">

    <spacer/>
    <text if="$isShowingViewFinder" foregroundColor="$settingsViewfinderColor" animationOpacity="animation:linear;duration:1;from:0;to:1;repeatForever:true;autoreverses:true">Scanning — keep adding passes</text>
    <text foregroundColor="white">Tap Done when finished</text>

    </vstack>

    <ViewFinderCorners if="$isShowingViewFinder" boxSize="0.6" color="$settingsViewfinderColor" animationScale="animation:linear;duration:1;from:1;to:0.9;repeatForever:true;autoreverses:true" animationOpacity="animation:linear;duration:1;from:0.5;to:1;repeatForever:true;autoreverses:true"/>

    </zstack>
    </navigationview>

    <button id="buttonCancelBatch" action="dismissSheet:item:sheetItem">Done</button>
    <toggle id="buttonTorchToggleBatch" key="torchActive" value="false" xxpadding="trailing">Torch</toggle>

    <event onValueUpdated="torchActive" action="torch:$torchActive"/>

</body>
