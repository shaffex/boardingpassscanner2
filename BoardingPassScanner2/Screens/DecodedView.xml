<body>
    <list navigationTitle="Skusky1" xxonAppear="decodeSelectedBoardingPass">
        <section header="Boarding Pass Fields">
            <text badge="$selectedCode.formatCode">Format Code (M)</text>
            <text badge="$selectedCode.numberOfLegs">Number of Legs</text>
            <text badge="$selectedCode.name">Passenger Name</text>
            <text badge="$selectedCode.passengerSurname">Surname</text>
            <text badge="$selectedCode.passengerGivenName">Given Name</text>
            <text badge="$selectedCode.electronicTicketIndicator">Electronic Ticket Indicator</text>
            <text badge="$selectedCode.pnr">Operating Carrier PNR</text>
            <text badge="$selectedCode.fromAirport">From Airport</text>
            <text badge="$selectedCode.fromAirportName">From Airport Name</text>
            <text badge="$selectedCode.fromAirportCity">From Airport City</text>
            <text badge="$selectedCode.fromAirportCountry">From Airport Country</text>
            <text badge="$selectedCode.toAirport">To Airport</text>
            <text badge="$selectedCode.toAirportName">To Airport Name</text>
            <text badge="$selectedCode.toAirportCity">To Airport City</text>
            <text badge="$selectedCode.toAirportCountry">To Airport Country</text>
            <text badge="$selectedCode.operatingCarrier">Operating Carrier</text>
            <text badge="$selectedCode.airlineName">Airline Name</text>
            <text badge="$selectedCode.airlineCountry">Airline Country</text>
            <text badge="$selectedCode.flightNumber">Flight Number</text>
            <text badge="$selectedCode.flightDateJulian">Flight Date (Julian)</text>
            <text badge="$selectedCode.flightDate">Flight Date</text>
            <text badge="$selectedCode.compartmentCode">Compartment Code</text>
            <text badge="$selectedCode.seatNumber">Seat Number</text>
            <text badge="$selectedCode.checkInSequenceNumber">Check-in Sequence Number</text>
            <text badge="$selectedCode.passengerStatus">Passenger Status</text>
        </section>
    </list>
</body>
